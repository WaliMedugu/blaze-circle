# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bank backend: mock (default, in-memory, resets on restart) or supabase (migrations 0001+0002, run scripts/seed.mjs)
BANK_BACKEND=mock

# Demo bank signing key — generate with: node scripts/gen-bank-key.mjs
BANK_PRIVATE_KEY_JWK=
NEXT_PUBLIC_BANK_PUBLIC_KEY=
